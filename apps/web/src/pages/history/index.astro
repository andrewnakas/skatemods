---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';

const scenes = (await getCollection('communities')).sort((a, b) => a.data.order - b.data.order);

const eras = [
  {
    years: '2000–2014', title: 'The Neversoft PC era',
    body: 'The Tony Hawk\'s PC ports were moddable from day one. GameSpy kept them online until it shut down in 2014, which pushed the community toward fan-run servers.',
    link: '/history/partymod/',
  },
  {
    years: '2007–2013', title: 'skate. resets the genre',
    body: 'EA Black Box\'s flick-it trilogy (2007, 2009, 2010) takes over from Tony Hawk\'s. It\'s console-only, so modding it means modded consoles. The studio closes in 2013.',
    link: '/history/skate-3/',
  },
  {
    years: '2013–2023', title: 'THUG Pro and the long tail',
    body: 'THUG Pro collects every Neversoft level into THUG2, and OpenSpy and PARTYMOD keep the classics running on modern PCs and online.',
    link: '/history/thug-pro/',
  },
  {
    years: '2018–2022', title: 'The sims open up',
    body: 'Skater XL (early access 2018) and Session put community maps at the center: mod.io, Unity Mod Manager, Session Mod Manager and the Illusory unlocker. Fan multiplayer comes before the official version.',
    link: '/history/skater-xl/',
  },
  {
    years: '2020–2025', title: 'Remakes and the revival',
    body: 'Unreal remakes of THPS 1+2 (2020) and 3+4 (2025) get Nexus mods and THPSPro. EA\'s skate. returns in 2025 as a free-to-play Frostbite game, locked down by kernel anti-cheat until ReSkate.',
    link: '/history/thps-pro/',
  },
  {
    years: '2026–', title: 'Skate 3 goes native',
    body: 'A static recompilation puts Skate 3 on PC, Android, iOS and the web. The world format gets fully documented, and maps start moving between every platform.',
    link: '/history/skate-3/',
  },
  {
    years: '2026–', title: 'skate. opens up',
    body: 'ReSkate 1.0 runs a pinned build of EA\'s 2025 skate. offline with a community runtime. On launch day its Thunderstore fills with Skate 3, skate 2 and Skater XL maps, and fans host their own servers.',
    link: '/history/reskate/',
  },
];
---
<Base title="History" description="A short history of skate game modding, from Neversoft's PC ports to Skate 3's native recompilation and ReSkate.">
  <PageHead title="A short history of skate game modding" lede="Twenty-six years of fans keeping their skate games alive after the publishers moved on." />
  <div class="wrap">
    <section class="scenes">
      <div class="rule-head"><h2>The scenes, in depth</h2><a href="/history/people/">The people →</a></div>
      <ol>
        {scenes.map((c) => (
          <li>
            <span class="meta">{c.data.years}</span>
            <div>
              <a href={`/history/${c.id}/`}>{c.data.title}</a>
              <p>{c.data.short}</p>
            </div>
            <span class="meta side">{c.data.people.length} credited</span>
          </li>
        ))}
      </ol>
    </section>
    <div class="rule-head"><h2>Twenty-six years in seven eras</h2></div>
    <ol class="eras">
      {eras.map((e) => (
        <li>
          <span class="years">{e.years}</span>
          <h2>{e.title}</h2>
          <p>{e.body}</p>
          <a href={e.link}>Scene history →</a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .scenes { margin-bottom: 3.5rem; }
  .scenes ol { list-style: none; margin: 0; padding: 0; }
  .scenes li { display: grid; grid-template-columns: 1fr; gap: 0.2rem 1.25rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) { .scenes li { grid-template-columns: 8rem 1fr 7rem; } .scenes .side { text-align: right; } }
  .scenes li > .meta { padding-top: 0.3rem; }
  .scenes a { font-weight: 600; font-size: 1.15rem; text-decoration: none; }
  .scenes a:hover { text-decoration: underline; color: var(--accent); }
  .scenes p { margin: 0.2rem 0 0; color: var(--ink-soft); }
  .eras { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .eras li { border-top: 4px solid var(--accent); padding-top: 0.8rem; }
  .years { font: 600 0.85rem var(--font-mono); color: var(--ink-faint); }
  .eras h2 { font-size: 1.35rem; margin: 0.3rem 0 0.5rem; }
  .eras p { color: var(--ink-soft); margin: 0 0 0.5rem; }
</style>

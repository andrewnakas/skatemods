---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { tools, kinds, type ToolKind } from '../data/tools';

const games = new Map((await getCollection('games')).map((g) => [g.id, g.data.title]));
const used = (Object.keys(kinds) as ToolKind[]).filter((k) => tools.some((t) => t.kind === k));
---
<Base title="Tools" description="Every skate modding tool in one place: ports, map converters, texture tools, servers, trainers and mod managers.">
  <PageHead title="The toolbox" lede={`${tools.length} ports, converters, servers, trainers and mod managers across ${new Set(tools.map((t) => t.game)).size} games.`} />
  <div class="wrap">
    <div class="filters" role="group" aria-label="Filter by kind">
      <button type="button" aria-pressed="true" data-kind="">All</button>
      {used.map((k) => <button type="button" aria-pressed="false" data-kind={k}>{kinds[k]}</button>)}
    </div>
    <div class="table-wrap">
      <table class="tools">
        <thead><tr><th>Tool</th><th class="hide-sm">What it does</th><th>Game</th></tr></thead>
        <tbody>
          {tools.map((t) => (
            <tr class="tool" data-kind={t.kind}>
              <td class="name"><a href={t.url}>{t.name}</a><span class="sub">{t.by}{t.open ? ' · open source' : ''}</span><span class="what-sm">{t.what}</span></td>
              <td class="hide-sm what">{t.what}</td>
              <td class="meta">{games.get(t.game)}<br />{kinds[t.kind]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="add">Missing a tool? <a href="https://github.com/andrewnakas/skatemods/blob/main/apps/web/src/data/tools.ts">Add it on GitHub</a>.</p>
  </div>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.tool')];
  for (const b of buttons) b.addEventListener('click', () => {
    for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
    for (const c of cards) c.hidden = !!b.dataset.kind && c.dataset.kind !== b.dataset.kind;
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-bottom: 1rem; }
  .filters button {
    font: 500 0.9rem var(--font-body); padding: 0.2rem 0; cursor: pointer;
    border: 0; border-bottom: 2px solid transparent; background: none; color: var(--ink-soft);
  }
  .filters button:hover { color: var(--ink); }
  .filters button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .name { width: 17rem; }
  .name a { font-weight: 600; text-decoration: none; }
  .name a:hover { text-decoration: underline; color: var(--accent); }
  .sub { display: block; font: 0.78rem var(--font-mono); color: var(--ink-faint); margin-top: 0.15rem; }
  .what { color: var(--ink-soft); }
  .what-sm { display: none; color: var(--ink-soft); font-size: 0.9rem; margin-top: 0.3rem; }
  td.meta { width: 11rem; }
  @media (max-width: 640px) { .hide-sm { display: none; } .what-sm { display: block; } .name { width: auto; } }
  .add { margin-top: 2rem; color: var(--ink-soft); }
</style>

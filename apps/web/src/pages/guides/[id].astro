---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const game = (await getCollection('games')).find((g) => g.id === guide.data.game);
const toc = headings.filter((h) => h.depth === 2);
const edit = `https://github.com/andrewnakas/skatemods/edit/main/apps/web/src/content/guides/${guide.id}.md`;
---
<Base title={guide.data.title} description={guide.data.description} type="article" image={`/og/guide-${guide.id}.png`} schema={{
  '@type': 'Article', headline: guide.data.title, description: guide.data.description, dateModified: guide.data.updated.toISOString(),
  author: { '@type': 'Organization', name: 'skatemods', url: 'https://skatemods.com/' }, image: `https://skatemods.com/og/guide-${guide.id}.png`,
  mainEntityOfPage: `https://skatemods.com/guides/${guide.id}/`,
}}>
  <PageHead parent={{ href: '/guides/', label: 'Guides' }} eyebrow={game?.data.title} title={guide.data.title} lede={guide.data.description} />
  <div class="wrap layout">
    <article class="prose">
      {guide.data.downloads.length > 0 && (
        <section class="get" aria-labelledby="get-h">
          <h2 id="get-h">Downloads and links</h2>
          <ul>
            {guide.data.downloads.map((d) => (
              <li><a href={d.url} rel="noopener">{d.label}</a>{d.note && <span class="note">{d.note}</span>}</li>
            ))}
          </ul>
        </section>
      )}
      <Content />
      <hr />
      <p class="foot">Updated {guide.data.updated.toISOString().slice(0, 10)} · <a href={edit}>Improve this guide on GitHub</a></p>
    </article>
    {toc.length > 1 && (
      <aside>
        <p class="h">On this page</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        {game && <p class="back"><a href={`/games/${game.id}/`}>← {game.data.title}</a></p>}
      </aside>
    )}
  </div>
</Base>

<style>
  .layout { display: grid; gap: 2rem; }
  @media (min-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr) 240px; } aside { position: sticky; top: 84px; align-self: start; } }
  aside { font-size: 0.9rem; }
  aside ul { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  aside li a { display: block; padding: 0.3rem 0.8rem; color: var(--ink-soft); text-decoration: none; }
  aside li a:hover { color: var(--ink); border-left: 2px solid var(--accent); margin-left: -2px; }
  .h { font-weight: 600; margin: 0 0 0.5rem; }
  .back { margin-top: 1rem; }
  .foot { font-size: 0.88rem; color: var(--ink-faint); }
  .get { border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); padding: 0.9rem 0 0.6rem; margin: 0 0 2rem; }
  .get h2 { font-size: 1.05rem; margin: 0 0 0.5rem; padding: 0; border: 0; }
  .get ul { list-style: none; margin: 0; padding: 0; }
  .get li { display: flex; flex-wrap: wrap; gap: 0.15rem 0.75rem; align-items: baseline; padding: 0.35rem 0; border-top: 1px solid var(--line); }
  .get li:first-child { border-top: 0; }
  .get a { font-weight: 600; }
  .get .note { color: var(--ink-faint); font-size: 0.9rem; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const games = new Map((await getCollection('games')).map((g) => [g.id, g.data.title]));
const levelTone = { beginner: 'ok', intermediate: 'warn', advanced: 'bad' } as const;
---
<Base title="Guides" description="Step-by-step guides for modding Skate 3, the classic Tony Hawk's games, Skater XL and Session.">
  <PageHead eyebrow="Guides" title="Guides" lede="Step by step, from your first native Skate 3 launch to converting maps between platforms." />
  <div class="wrap grid">
    {guides.map((g) => (
      <a class="card" href={`/guides/${g.id}/`}>
        <div class="meta"><span class="game">{games.get(g.data.game) ?? g.data.game}</span><span class={`chip ${levelTone[g.data.level]}`}>{g.data.level}</span></div>
        <h3>{g.data.title}</h3>
        <p>{g.data.description}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .meta { display: flex; justify-content: space-between; gap: 0.5rem; align-items: center; }
  .game { font-size: 0.8rem; color: var(--ink-faint); font-weight: 600; }
</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

// The browser build is offline until files from the retail game that slipped into it are removed.
// The full page is in git history (before this change) for when it comes back.
---
<Base title="Clean Room Skate Online is offline" description="Clean Room Skate Online, the fan-made Skate 3 browser build, is offline for now. Other ways to play Skate 3 on PC, Mac, Steam Deck and Android are below." noindex>
  <PageHead title="Clean Room Skate Online is offline" lede="The browser build is down while we take out files from the retail game that ended up in it by mistake. It will come back once it contains only our own art, sound and animation." />
  <div class="wrap prose">
    <p>To play Skate 3 now:</p>
    <ul>
      <li><a href="/guides/skate-3-recomp/">Skate 3 Recomp</a>: the native PC port, with your own Xbox 360 copy.</li>
      <li><a href="/guides/skate-3-on-rpcs3/">RPCS3</a>: the PS3 version, with online play through the <a href="/faq/skate-3-online/">community Blaze server</a>.</li>
      <li><a href="/guides/play-skate-3-anywhere/">Every way to play Skate 3</a>, compared.</li>
    </ul>
    <p>Community maps are still on <a href="/maps/">/maps/</a>, and for EA's new skate. there's <a href="/guides/play-skate-with-reskate/">ReSkate</a>.</p>
  </div>
</Base>

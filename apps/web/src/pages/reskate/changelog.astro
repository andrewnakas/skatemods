---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getReleases } from '../../lib/reskate-releases';
import { day } from '../../lib/thunderstore';

// Every ReSkate release with the commits that went into it, rebuilt on each deploy.
const releases = await getReleases();
const latest = releases[0];
const n = (x: number) => x.toLocaleString('en-US');
const total = releases.reduce((s, r) => s + r.downloads, 0);
const title = latest ? `ReSkate changelog: every update up to ${latest.tag}` : 'ReSkate changelog';
const description = latest
  ? `What changed in each ReSkate release, from v1.0.0 on October 2, 2026 to ${latest.tag} on ${day(latest.date)}: ${releases.length} releases, taken from the commits on GitHub.`
  : 'What changed in each ReSkate release, taken from the commits on GitHub.';
---
<Base title={title} description={description} schema={{
  '@type': 'CollectionPage', name: 'ReSkate changelog', url: 'https://skatemods.com/reskate/changelog/', description,
  dateModified: latest?.date,
}}>
  <PageHead parent={{ href: '/reskate/', label: 'ReSkate mods' }} title="ReSkate changelog" lede="Every ReSkate release and what went into it. The releases on GitHub have no notes, so each entry lists the commits since the release before it, minus merges.">
    {latest && (
      <p class="meta facts">
        Latest: <a href={latest.url}>{latest.tag}</a>, {day(latest.date)} · {releases.length} releases · {n(total)} downloads from GitHub ·
        <a href="https://github.com/Dingo-Shenanigans/ReSkate/releases/latest">Download the latest</a> · <a href="/guides/play-skate-with-reskate/">Install guide</a>
      </p>
    )}
  </PageHead>
  <div class="wrap">
    {releases.length === 0 && <p>GitHub couldn't be reached when this page was built. See <a href="https://github.com/Dingo-Shenanigans/ReSkate/releases">ReSkate's releases on GitHub</a>.</p>}
    <ol class="releases">
      {releases.map((r) => (
        <li id={r.tag}>
          <h2><a href={r.url}>{r.tag}</a></h2>
          <p class="meta">{day(r.date)} · {n(r.downloads)} downloads</p>
          {r.changes.length > 0
            ? <ul>{r.changes.map((c) => <li><a href={c.url} rel="nofollow noopener">{c.text}</a></li>)}</ul>
            : <p class="faint">{r === releases[releases.length - 1] ? 'The first public release.' : 'No code changes listed.'}</p>}
        </li>
      ))}
    </ol>
    <div class="callout note">
      <p>Servers and players need matching ReSkate versions when the network protocol changes. If you can't join a server after an update, update the launcher first. Problems after updating: <a href="/faq/reskate-not-working/">ReSkate isn't working</a>. The story behind the releases: <a href="/history/reskate/">ReSkate history</a>.</p>
    </div>
  </div>
</Base>

<style>
  .facts { margin: 1rem 0 0; }
  .releases { list-style: none; padding: 0; margin: 0; max-width: 80ch; }
  .releases > li { border-top: 2px solid var(--ink); padding: 0.9rem 0 1.4rem; }
  .releases h2 { margin: 0; font-size: 1.5rem; }
  .releases h2 a { color: inherit; text-decoration: none; }
  .releases .meta { margin: 0.2rem 0 0.6rem; }
  .releases ul { margin: 0; padding-left: 1.2rem; }
  .releases ul li { margin: 0.2rem 0; }
  .releases ul a { color: var(--ink); text-decoration: none; }
  .releases ul a:hover { color: var(--accent); text-decoration: underline; }
  .faint { color: var(--ink-faint); }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import { timeline, formatDate } from '../data/skate3-timeline';
import { hubs, hubStats } from '../data/hubs';
import catalog from '../data/catalog.json';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id));
// The home feature is the post marked `featured`, or the newest one.
const lead = posts.find((p) => p.data.featured) ?? posts[0];

// Newest skate. mods, baked in at build time and refreshed in the browser.
let fresh: { name: string; owner: string; url: string; icon: string; downloads: number }[] = [];
try {
  const packages = await (await fetch('https://thunderstore.io/c/reskate/api/v1/package/', { signal: AbortSignal.timeout(10000) })).json();
  fresh = packages
    .filter((p: any) => !p.is_deprecated && !p.has_nsfw_content && p.versions?.length)
    .sort((a: any, b: any) => b.date_created.localeCompare(a.date_created))
    .slice(0, 6)
    .map((p: any) => ({ name: p.name.replace(/_/g, ' '), owner: p.owner, url: p.package_url, icon: p.versions[0].icon, downloads: p.versions.reduce((n: number, v: any) => n + v.downloads, 0) }));
} catch {}

const servers = hubs.filter((h) => h.kind === 'discord').slice(0, 4);
const serverStats = await Promise.all(servers.map((h) => hubStats(h.invite!)));
// Newest first. Exact dates only, so a bare year like "2010s" never jumps the queue.
const recent = timeline.filter((e) => e.date.length === 10).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
const doors = [
  { n: '01', href: '/guides/play-skate-3-on-pc/', title: 'Play Skate 3 on PC', body: 'The native recompilation for Windows, Linux and macOS, from your own disc.' },
  { n: '02', href: '/maps/', title: 'Get community maps', body: 'Download maps that convert to every platform, or upload your own.' },
  { n: '03', href: '/guides/play-skate-with-reskate/', title: 'Mod the new skate.', body: 'ReSkate: 200+ custom maps and mods, a park editor, a trainer and community servers.' },
  { n: '04', href: '/games/', title: 'Mod another game', body: 'THUG Pro, Skater XL, Session and the rest: what works, where to start.' },
];
---
<Base title="skatemods">
  <section class="mast">
    <div class="wrap mast-grid">
      <div>
        <h1>Mod every<br />skate game.</h1>
        <p class="lede">A reference for modding skate games, written by players. Guides and history for every game, from Skate 3 to the new skate., and a home for Skate 3 maps that converts each upload between PS3, the PC recomp and the Rust engine.</p>
      </div>
      <ol class="doors">
        {doors.map((d) => (
          <li><a href={d.href}><span class="n">{d.n}</span><span><strong>{d.title}</strong><span>{d.body}</span></span></a></li>
        ))}
      </ol>
    </div>
  </section>

  {lead && (
    <section class="feature">
      <div class="wrap feature-grid">
        <div>
          <p class="meta kicker"><a href="/blog/">Blog</a> · <time datetime={lead.data.date.toISOString().slice(0, 10)}>{formatDate(lead.data.date.toISOString().slice(0, 10))}</time></p>
          <h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
          <p class="lede">{lead.data.description}</p>
          <p class="btns"><a class="btn primary" href={`/blog/${lead.id}/`}>Read the post</a> <a class="btn" href="/guides/play-skate-with-reskate/">Install ReSkate</a> <a class="btn" href="/reskate/">Browse mods</a></p>
        </div>
        <ul class="facts">
          <li><span class="meta">Game</span><span><a href="/games/skate-2025/">skate. (2025), pinned Steam build 25414733</a></span></li>
          <li><span class="meta">Get</span><span><a href="https://github.com/Dingo-Shenanigans/ReSkate/releases/latest">ReSkate on GitHub</a>, GPL-3.0, Windows (Linux via Proton)</span></li>
          <li><span class="meta">Mods</span><span><a href="/reskate/">Browse every skate. mod</a>: maps from Skate 3, skate 2, Skater XL, THUG2 and GTA, plus cosmetics and soundtracks</span></li>
          <li><span class="meta">Host</span><span><a href="/guides/host-a-reskate-server/">Run a dedicated server</a> on Windows or Linux, no ports to open</span></li>
          <li><span class="meta">History</span><span><a href="/history/reskate/">The ReSkate timeline and people</a></span></li>
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap two">
      <div>
        <div class="rule-head"><h2>New skate. mods</h2><a href="/reskate/">All mods</a></div>
        <ul class="list mods" id="fresh">
          {fresh.length ? fresh.map((m) => (
            <li><img src={m.icon} alt="" width="40" height="40" loading="lazy" /><span><a href={m.url}>{m.name}</a> <span class="who">by {m.owner}</span></span></li>
          )) : <li class="empty">Mods load from <a href="https://thunderstore.io/c/reskate/">Thunderstore</a>.</li>}
        </ul>
      </div>
      <div>
        <div class="rule-head"><h2>From the blog</h2><a href="/blog/">All posts</a></div>
        <ul class="list posts">
          {posts.slice(0, 4).map((p) => (
            <li><time class="meta">{formatDate(p.data.date.toISOString().slice(0, 10))}</time><span><a href={`/blog/${p.id}/`}>{p.data.title}</a></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <div class="rule-head"><h2>New Skate 3 maps</h2><a href="/maps/">All maps</a></div>
        <ul class="list" id="latest" data-packs={catalog.packs.length} data-maps={catalog.packs.flatMap((p) => p.maps).length}><li class="meta">Loading…</li></ul>
      </div>
      <div>
        <div class="rule-head"><h2>Skate 3 log</h2><a href="/history/skate-3/">Full history</a></div>
        <ul class="list log">
          {recent.map((e) => (
            <li><time class="meta">{formatDate(e.date)}</time><span>{e.title}{e.who && <span class="who"> ({e.who})</span>}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="rule-head"><h2>Games</h2><a href="/games/">All games</a></div>
      <div class="table-wrap">
        <table class="games">
          <thead><tr><th>Year</th><th>Game</th><th class="hide-sm">Engine</th><th>Modding</th></tr></thead>
          <tbody>
            {games.map((g) => (
              <tr>
                <td class="meta">{g.data.year}</td>
                <td><a href={`/games/${g.id}/`}>{g.data.title}</a></td>
                <td class="hide-sm muted">{g.data.engine}</td>
                <td><Scene scene={g.data.scene} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="rule-head"><h2>Discord servers</h2><a href="/community/">All communities</a></div>
      <ul class="servers">
        {servers.map((h, i) => (
          <li>
            <a href={`https://discord.gg/${h.invite}`} rel="noopener">
              {serverStats[i].icon ? <img src={serverStats[i].icon} alt="" width="40" height="40" loading="lazy" /> : <span class="ph" aria-hidden="true">{h.name[0]}</span>}
              <span><strong>{h.name}</strong><span class="meta">{serverStats[i].members ? `${serverStats[i].members!.toLocaleString('en-US')} members` : 'Discord'}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap convert">
      <div class="rule-head"><h2>Map conversion</h2><a href="/convert/">How conversion works</a></div>
      <p class="flow"><span>PS3 <code>DIST_*.psf</code></span><b aria-hidden="true">→</b><span>recomp <code>.big</code></span><b aria-hidden="true">→</b><span>Rust engine <code>.skate</code></span></p>
      <p class="muted">Skate 3 maps you upload are converted on free GitHub runners with no game files involved, checked against the upload policy, and published after a person reviews them.</p>
      <p class="btns"><a class="btn primary" href="/upload/">Upload a map</a> <a class="btn" href="/policy/">Upload policy</a></p>
    </div>
  </section>
</Base>

<script>
  import { api, esc, formatDate } from '../lib/api';
  const ul = document.getElementById('latest')!;
  api('/maps').then(({ maps }) => {
    ul.innerHTML = maps.length
      ? maps.slice(0, 6).map((m: any) => `<li><time class="meta">${formatDate(m.approved_at)}</time><span><a href="/maps/view/?id=${m.id}">${esc(m.title)}</a> <span class="who">by ${esc(m.author_credit)}</span></span></li>`).join('')
      : `<li class="empty"><strong>No uploads yet.</strong> Upload a Skate 3 map once and it's converted for PS3, the PC recomp and the Rust engine, then published after review. <a href="/upload/">Upload a map</a> or browse <a href="/maps/">${ul.dataset.packs} known packs (${ul.dataset.maps} maps)</a>.</li>`;
  }).catch(() => { ul.innerHTML = '<li class="empty">Maps are unavailable right now.</li>'; });
</script>

<style>
  .mast { padding: 3.5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  .mast-grid { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 940px) { .mast-grid { grid-template-columns: 1.35fr 1fr; } }
  .mast h1 { font-size: clamp(3.2rem, 10vw, 7rem); margin-bottom: 1.25rem; }
  .doors { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .doors a { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .doors a:hover strong { color: var(--accent); }
  .doors .n { font: 500 0.85rem/1.6 var(--font-mono); color: var(--accent); }
  .doors strong { display: block; font-size: 1.05rem; }
  .doors a > span > span { color: var(--ink-soft); font-size: 0.93rem; }

  .feature { padding: 2.5rem 0; border-bottom: 1px solid var(--line); }
  .feature-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 940px) { .feature-grid { grid-template-columns: 1.35fr 1fr; gap: 3rem; } }
  .feature .kicker { margin: 0 0 0.75rem; color: var(--accent); }
  .feature .kicker a { color: inherit; }
  .feature h2 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 1rem; }
  .feature h2 a { color: inherit; text-decoration: none; }
  .feature h2 a:hover { color: var(--accent); }
  .feature .lede { margin-bottom: 1.25rem; }
  .facts { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .facts li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .facts .meta { padding-top: 0.1rem; }

  .list.mods :global(li) { grid-template-columns: 40px 1fr; align-items: center; }
  .mods img { width: 40px; height: 40px; object-fit: cover; border-radius: var(--radius); background: var(--line); }
  .mods a, .posts a { font-weight: 600; text-decoration: none; }
  .mods a:hover, .posts a:hover { text-decoration: underline; color: var(--accent); }
  .servers { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .servers a { display: grid; grid-template-columns: 40px 1fr; gap: 0.85rem; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .servers a:hover strong { color: var(--accent); }
  .servers img, .servers .ph { width: 40px; height: 40px; border-radius: var(--radius); }
  .servers .ph { display: grid; place-items: center; background: var(--ink); color: var(--bg); font-weight: 800; }
  .servers strong { display: block; line-height: 1.25; }

  .two { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; } }
  .list { list-style: none; margin: 0; padding: 0; }
  .list :global(li) { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
  .list :global(.empty) { display: block; color: var(--ink-soft); }
  .list :global(.who), .muted { color: var(--ink-faint); }
  .list time { padding-top: 0.15rem; }

  .games td:first-child { width: 4.5rem; }
  .games a { font-weight: 600; text-decoration: none; }
  .games a:hover { text-decoration: underline; }
  @media (max-width: 600px) { .hide-sm { display: none; } }

  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; font-size: 1.15rem; margin: 1.5rem 0; }
  .flow b { color: var(--accent); font-weight: 400; }
  .convert .muted { max-width: 64ch; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import { timeline, formatDate } from '../data/skate3-timeline';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const recent = [...timeline].reverse().slice(0, 6);
const doors = [
  { n: '01', href: '/guides/play-skate-3-on-pc/', title: 'Play Skate 3 on PC', body: 'The native recompilation for Windows, Linux and macOS, from your own disc.' },
  { n: '02', href: '/maps/', title: 'Get community maps', body: 'Download maps that convert to every platform, or upload your own.' },
  { n: '03', href: '/games/', title: 'Mod another game', body: 'THUG Pro, Skater XL, Session and the rest: what works, where to start.' },
];
---
<Base title="skatemods">
  <section class="mast">
    <div class="wrap mast-grid">
      <div>
        <h1>Mod every<br />skate game.</h1>
        <p class="lede">A reference for modding skate games, written by players. Guides and history for every game, and a home for Skate 3 maps that converts each upload between PS3, the PC recomp and the Rust engine.</p>
      </div>
      <ol class="doors">
        {doors.map((d) => (
          <li><a href={d.href}><span class="n">{d.n}</span><span><strong>{d.title}</strong><span>{d.body}</span></span></a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <div class="rule-head"><h2>New maps</h2><a href="/maps/">All maps</a></div>
        <ul class="list" id="latest"><li class="meta">Loading…</li></ul>
      </div>
      <div>
        <div class="rule-head"><h2>Skate 3 log</h2><a href="/history/skate-3/">Full history</a></div>
        <ul class="list log">
          {recent.map((e) => (
            <li><time class="meta">{formatDate(e.date)}</time><span>{e.title}{e.who && <span class="who"> ({e.who})</span>}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="rule-head"><h2>Games</h2><a href="/games/">Index</a></div>
      <div class="table-wrap">
        <table class="games">
          <thead><tr><th>Year</th><th>Game</th><th class="hide-sm">Engine</th><th>Modding</th></tr></thead>
          <tbody>
            {games.map((g) => (
              <tr>
                <td class="meta">{g.data.year}</td>
                <td><a href={`/games/${g.id}/`}>{g.data.title}</a></td>
                <td class="hide-sm muted">{g.data.engine}</td>
                <td><Scene scene={g.data.scene} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap convert">
      <div class="rule-head"><h2>One upload, every platform</h2><a href="/convert/">How it works</a></div>
      <p class="flow"><span>PS3 <code>DIST_*.psf</code></span><b aria-hidden="true">→</b><span>recomp <code>.big</code></span><b aria-hidden="true">→</b><span>Rust engine <code>.skate</code></span></p>
      <p class="muted">Skate 3 maps you upload are converted on free GitHub runners with no game files involved, checked against the upload policy, and published after a person reviews them.</p>
      <p><a class="btn primary" href="/upload/">Upload a map</a> <a class="btn" href="/policy/">Upload policy</a></p>
    </div>
  </section>
</Base>

<script>
  import { api, esc, formatDate } from '../lib/api';
  const ul = document.getElementById('latest')!;
  api('/maps').then(({ maps }) => {
    ul.innerHTML = maps.length
      ? maps.slice(0, 6).map((m: any) => `<li><time class="meta">${formatDate(m.approved_at)}</time><span><a href="/maps/view/?id=${m.id}">${esc(m.title)}</a> <span class="who">by ${esc(m.author_credit)}</span></span></li>`).join('')
      : '<li class="empty">No maps published yet. <a href="/upload/">Upload the first one.</a></li>';
  }).catch(() => { ul.innerHTML = '<li class="empty">Maps are unavailable right now.</li>'; });
</script>

<style>
  .mast { padding: 3.5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  .mast-grid { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 940px) { .mast-grid { grid-template-columns: 1.35fr 1fr; } }
  .mast h1 { font-size: clamp(3.2rem, 10vw, 7rem); margin-bottom: 1.25rem; }
  .doors { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .doors a { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .doors a:hover strong { color: var(--accent); }
  .doors .n { font: 500 0.85rem/1.6 var(--font-mono); color: var(--accent); }
  .doors strong { display: block; font-size: 1.05rem; }
  .doors a > span > span { color: var(--ink-soft); font-size: 0.93rem; }

  .two { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; } }
  .list { list-style: none; margin: 0; padding: 0; }
  .list :global(li) { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
  .list :global(.empty) { display: block; color: var(--ink-soft); }
  .list :global(.who), .muted { color: var(--ink-faint); }
  .list time { padding-top: 0.15rem; }

  .games td:first-child { width: 4.5rem; }
  .games a { font-weight: 600; text-decoration: none; }
  .games a:hover { text-decoration: underline; }
  @media (max-width: 600px) { .hide-sm { display: none; } }

  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; font-size: 1.15rem; margin: 1.5rem 0; }
  .flow b { color: var(--accent); font-weight: 400; }
  .convert .muted { max-width: 64ch; }
  .convert .btn + .btn { margin-left: 0.5rem; }
</style>

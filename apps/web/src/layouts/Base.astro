---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Social card under /og/, e.g. '/og/blog-reskate-launch.png'. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD for the page (an Article, for example). */
  schema?: Record<string, unknown>;
}

const { title, description = 'The open-source hub for modding every skate game: guides, history, community Skate 3 maps and automatic PS3 / recomp / .skate conversion.', image = '/og/default.png', type = 'website', schema } = Astro.props;
const imageUrl = new URL(image, 'https://skatemods.com');
const fullTitle = title === 'skatemods' ? 'skatemods: modding every skate game' : `${title} · skatemods`;
const path = Astro.url.pathname;

const nav = [
  { href: '/games/', label: 'Games' },
  { href: '/maps/', label: 'Maps' },
  { href: '/reskate/', label: 'Mods' },
  { href: '/guides/', label: 'Guides' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/history/', label: 'History' },
  { href: '/blog/', label: 'Blog' },
  { href: '/community/', label: 'Community' },
  { href: '/tools/', label: 'Tools' },
];
const active = (href: string) => path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="skatemods" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#d63a1f" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />}
    <meta property="og:url" content={new URL(path, 'https://skatemods.com')} />
    <link rel="alternate" type="application/rss+xml" title="skatemods blog" href="/blog/rss.xml" />
    <link rel="canonical" href={new URL(path, 'https://skatemods.com')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label="skatemods home">skate<span>mods</span></a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="actions">
          <a class="upload" href="/upload/">Upload</a>
          <a class="account" id="account" href="/signin/">Sign in</a>
          <button class="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5v11a5.5 5.5 0 0 1 0-11z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div class="about">
            <p class="logo">skate<span>mods</span></p>
            <p>A community reference for modding skate games. Open source, run by players, not affiliated with EA, Activision, Easy Day Studios, Crea-ture Studios or any publisher. No game files are hosted here.</p>
          </div>
          <nav aria-label="Learn">
            <p class="h">Learn</p>
            <a href="/games/">Games</a><a href="/guides/">Guides</a><a href="/faq/">FAQ</a><a href="/history/">History</a><a href="/history/people/">The people</a><a href="/blog/">Blog</a><a href="/community/">Community</a><a href="/tools/">Tools</a>
          </nav>
          <nav aria-label="Skate 3">
            <p class="h">Skate 3</p>
            <a href="/maps/">Maps</a><a href="/upload/">Upload a map</a><a href="/convert/">Conversion</a><a href="/recomp/">Recomp builds</a><a href="/play/">Play in browser</a>
          </nav>
          <nav aria-label="skate. (2025)">
            <p class="h">skate. (2025)</p>
            <a href="/reskate/">Mods</a><a href="/guides/play-skate-with-reskate/">Play with ReSkate</a><a href="/guides/host-a-reskate-server/">Host a server</a><a href="/history/reskate/">ReSkate history</a>
          </nav>
          <nav aria-label="Project">
            <p class="h">Project</p>
            <a href="https://github.com/andrewnakas/skatemods">Source code</a><a href="/about/">About</a><a href="/policy/">Upload policy</a><a href="/policy/#takedowns">Takedowns</a>
          </nav>
        </div>
      </div>
    </footer>

    <script>
      import { getMe } from '../lib/api';
      getMe().then((me) => {
        if (!me) return;
        const a = document.getElementById('account') as HTMLAnchorElement;
        a.textContent = me.login;
        a.href = '/me/';
        a.title = 'My maps';
      });
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header { background: var(--bg); border-bottom: 2px solid var(--ink); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; gap: 0.5rem 1.75rem; min-height: 56px; flex-wrap: wrap; }
  .logo {
    font: 900 1.55rem/1 var(--font-display); font-stretch: 70%; text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--ink); text-decoration: none; padding: 0.25rem 0;
  }
  .logo span { color: var(--accent); }
  nav[aria-label='Main'] { display: flex; gap: 1.25rem; order: 3; width: 100%; overflow-x: auto; padding-bottom: 0.5rem; scrollbar-width: none; }
  nav[aria-label='Main'] a { color: var(--ink-soft); text-decoration: none; font-weight: 500; font-size: 0.95rem; white-space: nowrap; padding: 0.15rem 0; border-bottom: 2px solid transparent; }
  nav[aria-label='Main'] a:hover { color: var(--ink); }
  nav[aria-label='Main'] a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 1rem; font-size: 0.92rem; }
  .actions a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .actions a:hover { color: var(--accent); }
  .upload { border: 1.5px solid var(--ink); padding: 0.3rem 0.65rem; border-radius: var(--radius); }
  .upload:hover { background: var(--ink); color: var(--bg) !important; }
  .account { font-family: var(--font-mono); font-size: 0.85rem; max-width: 14ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .theme { display: grid; place-items: center; width: 30px; height: 30px; border: 0; background: none; color: var(--ink-soft); cursor: pointer; padding: 0; }
  .theme:hover { color: var(--ink); }
  @media (max-width: 1079px) {
    /* The nav scrolls sideways on small screens; fade the edge so it reads as more. */
    nav[aria-label='Main'] { mask-image: linear-gradient(to right, #000 85%, transparent); padding-right: 2rem; }
  }
  @media (max-width: 520px) {
    .bar { column-gap: 0.75rem; }
    .actions { gap: 0.6rem; }
    .logo { font-size: 1.35rem; }
  }
  @media (min-width: 1080px) {
    nav[aria-label='Main'] { order: 0; width: auto; padding: 0; }
  }
  .skip:focus { position: fixed; left: 1rem; top: 1rem; width: auto; height: auto; clip: auto; z-index: 99; background: var(--ink); color: var(--bg); padding: 0.5rem 1rem; }

  .site-footer { border-top: 2px solid var(--ink); margin-top: 5rem; padding: 2rem 0 3rem; font-size: 0.9rem; }
  .cols { display: grid; gap: 1.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .about { grid-column: 1 / -1; max-width: 56ch; }
  @media (min-width: 960px) { .cols { grid-template-columns: 2fr repeat(4, 1fr); } .about { grid-column: auto; } }
  .about p { color: var(--ink-soft); margin: 0.5rem 0 0; }
  .about .logo { font-size: 1.25rem; margin: 0; }
  .cols nav { display: flex; flex-direction: column; gap: 0.3rem; }
  .cols nav a { color: var(--ink-soft); text-decoration: none; }
  .cols nav a:hover { color: var(--accent); }
  .h { font: 500 0.75rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); margin: 0 0 0.3rem; }
</style>
